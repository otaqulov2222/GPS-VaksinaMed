{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/router.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,scripts/**,terminals/**,agent-transcripts/**,*.html,*.js,*.css,fonts/**,logo/**,start.bat,Procfile,render.yaml,office-seed.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/router?path=$1" },
    { "source": "/gps-proxy", "destination": "/api/router?path=gps-proxy" }
  ]
}
