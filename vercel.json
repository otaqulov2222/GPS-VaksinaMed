{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{data/**,scripts/**,.git/**,terminals/**,agent-transcripts/**,start.bat,Procfile,render.yaml,.vercelignore}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/gps-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/health",
      "schedule": "*/4 * * * *"
    }
  ]
}
