# VaksinaMed Fleet Control — muhit o'zgaruvchilari
# Lokal: nusxa → .env   |   Vercel: Project → Settings → Environment Variables

# ── Neon PostgreSQL (majburiy, production) ───────────────────
# Neon Dashboard → Connection string → «Pooled connection»
# sslmode=require bo'lishi kerak
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Production
VM_PRODUCTION=1

# Admin Pro boshlang'ich paroli (faqat birinchi marta users bo'sh bo'lsa)
VM_SEED_PASS=AdminPro@2026

# ── Vercel Cron + GitHub zaxira (GPS) ────────────────────────
# Pro: vercel.json → crons */15 0-17 * * * → /api/cron/gps-sync
# CRON_SECRET — Vercel cron Authorization Bearer (majburiy)
CRON_SECRET=
# Ixtiyoriy zaxira: Vercel cron GitHub Actions ni uyg'otadi (og'ir sync Vercelda EMAS)
# GitHub → Settings → Developer settings → PAT (classic): repo + workflow
GH_PAT=
# Ixtiyoriy (default: otaqulov2222/GPS-VaksinaMed, main, gps-sync.yml)
# GITHUB_REPOSITORY=otaqulov2222/GPS-VaksinaMed
# GH_REF=main

# ── GPS (ixtiyoriy — paneldan ham kiritish mumkin) ───────────
GPS_HOST=http://bms1.gpsavto.uz
GPS_TOKEN=
GPS_USER=
GPS_PASSWORD=
GPS_SYNC_INTERVAL=300

# ── HR API (ixtiyoriy) ───────────────────────────────────────
VM_HR_API_KEY=

# ── Ichki yordamchi AI (ixtiyoriy) ───────────────────────────
# Bo'sh bo'lsa: offline FAQ (matn). Skrin + to'liq AI uchun kalit kerak.
# OpenAI Dashboard → API keys. Hech qachon repoga commit qilmang.
OPENAI_API_KEY=
# Ixtiyoriy model (default: gpt-4o-mini — arzon, skrin ko'radi)
# OPENAI_SUPPORT_MODEL=gpt-4o-mini

# ── Lokal server ─────────────────────────────────────────────
PORT=8080
