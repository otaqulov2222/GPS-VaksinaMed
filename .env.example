# VaksinaMed GPS — muhit o'zgaruvchilari (Render / production)

# Majburiy (production): PostgreSQL — ma'lumot deploydan keyin saqlansin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server port (Render avtomatik beradi)
PORT=8080

# Birinchi Admin Pro paroli (faqat users bo'sh bo'lsa seed qilinadi)
VM_SEED_PASS=AdminPro@2026

# GPS login/token brauzerda CFG → GPS modal orqali saqlanadi (kodda emas)
