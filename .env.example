# VaksinaMed Fleet Control — muhit o'zgaruvchilari
# Lokal: nusxa → .env   |   Hetzner: /opt/vaksina/app/.env

# ── Ma'lumot saqlash (Hetzner VPS) ───────────────────────────
# Hozir asosiy: lokal fayl  →  data/kv/*.json  (server ichida)
# Ixtiyoriy kuchaytirish: shu VPS dagi PostgreSQL (Neon EMAS)
# DATABASE_URL bo'lsa → PostgreSQL + fayl zaxira (DualPersist)
# DATABASE_URL yo'q bo'lsa → faqat fayl (hozirgi ishlash holati)
# DATABASE_URL=postgresql://vaksina:PAROL@127.0.0.1:5432/vaksina
# PERSIST_DIR=   # bo'sh = app root; ixtiyoriy alohida disk yo'li

# Production
VM_PRODUCTION=1

# Admin Pro boshlang'ich paroli (faqat birinchi marta users bo'sh bo'lsa)
VM_SEED_PASS=AdminPro@2026

# ── Cron / deploy (ixtiyoriy) ────────────────────────────────
CRON_SECRET=
GH_PAT=
# GITHUB_REPOSITORY=otaqulov2222/GPS-VaksinaMed
# GH_REF=main

# ── GPS (ixtiyoriy — paneldan ham kiritish mumkin) ───────────
GPS_HOST=http://bms1.gpsavto.uz
GPS_TOKEN=
GPS_USER=
GPS_PASSWORD=
GPS_SYNC_INTERVAL=300

# ── HR / Logistika integratsiya (vaksinahr.uz) ───────────────
# Yoqilmasa asosiy tizim o'zgarmaydi (API 503)
VM_HR_API_KEY=
# Brauzer uchun to'liq HTTPS manzil (SSO enterUrl)
VM_PUBLIC_BASE_URL=https://your-gps-domain.uz
# HR orqali kira oladigan VaksinaMed loginlar (vergul bilan, 2–3 ta)
VM_HR_SSO_USERS=adminpro,direktor,hradmin
# Ixtiyoriy: HR email → bizning login  (email@hr.uz:adminpro)
# VM_HR_SSO_MAP=
# iframe uchun HR domen(lar)
VM_HR_FRAME_ANCESTORS=https://vaksinahr.uz

# ── Ichki yordamchi AI (ixtiyoriy) ───────────────────────────
OPENAI_API_KEY=
# OPENAI_SUPPORT_MODEL=gpt-4o-mini

# ── Lokal server ─────────────────────────────────────────────
PORT=8080
