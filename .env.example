# VaksinaMed Fleet Control — muhit o'zgaruvchilari
# Lokal: nusxa → .env   |   Vercel: Project → Settings → Environment Variables

# ── Neon PostgreSQL (majburiy, production) ───────────────────
# Neon Dashboard → Connection string → «Pooled connection»
# sslmode=require bo'lishi kerak
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Production
VM_PRODUCTION=1

# Admin Pro boshlang'ich paroli (faqat birinchi marta users bo'sh bo'lsa)
VM_SEED_PASS=AdminPro@2026

# ── Vercel Cron (GPS avtomatik sync) ─────────────────────────
# Hobby: Vercel cron ishlatilmaydi — GitHub Actions (har 5 daqiqa):
#   GitHub → Settings → Secrets → Actions:
#     CRON_SECRET  = Vercel bilan bir xil
#     GPS_SYNC_URL = https://APP.vercel.app/api/cron/gps-sync
# Pro: Vercel Dashboard → Cron Jobs → */5 * * * * → /api/cron/gps-sync
CRON_SECRET=

# ── GPS (ixtiyoriy — paneldan ham kiritish mumkin) ───────────
GPS_HOST=http://bms1.gpsavto.uz
GPS_TOKEN=
GPS_USER=
GPS_PASSWORD=
GPS_SYNC_INTERVAL=300

# ── HR API (ixtiyoriy) ───────────────────────────────────────
VM_HR_API_KEY=

# ── Lokal server ─────────────────────────────────────────────
PORT=8080
