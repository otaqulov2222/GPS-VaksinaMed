# VaksinaMed ↔ vaksinahr.uz — HR Logistika defaultlari (kalitsiz).
# Haqiqiy VM_HR_API_KEY faqat server .env da bo'lsin (gitga yozilmasin).
# Yuklash: avval .env (override), keyin shu fayl (faqat bo'sh env uchun).
VM_PUBLIC_BASE_URL=https://vaksinamedgps.uz
VM_HR_SSO_USERS=adminpro
VM_HR_FRAME_ANCESTORS=https://vaksinahr.uz https://www.vaksinahr.uz
# VM_PRODUCTION ni .env belgilaydi — bu yerda majburiy qilmaymiz
